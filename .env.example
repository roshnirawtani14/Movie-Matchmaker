# Frontend (Vite) — safe to expose in the browser bundle.
# From your Supabase project: Settings -> API
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ---------------------------------------------------------------------------
# The keys below are SECRET and must never go in the frontend or be committed.
# Set them as Supabase Edge Function secrets instead, e.g.:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#   supabase secrets set TMDB_API_KEY=...
#   supabase secrets set RAPIDAPI_KEY=...
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are already injected automatically
# into every Edge Function by Supabase — you don't need to set those yourself.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
TMDB_API_KEY=your-tmdb-v4-read-access-token
RAPIDAPI_KEY=your-rapidapi-key
